<?xml version="1.0" encoding="UTF-8"?>
<!--
    ihaveissuesui.rc -- the menu bar and toolbar layout.

    Only this application's OWN actions appear here. The standard ones
    (file_new, file_open, file_save, file_save_as, file_quit,
    options_configure, and the Settings/Help menus) are placed by KXmlGui's own
    ui_standards.rc, which this file is merged over -- listing them again would
    duplicate them.

    VERIFY: the merge point named below. ui_standards.rc's File menu defines
    new_merge / open_merge / save_merge / revert_merge / print_merge /
    close_merge, and append="save_merge" puts the two markdown actions directly
    after Save As. If a KF6 ui_standards.rc has renamed it, the actions simply
    land at the end of the File menu instead of mid-way -- cosmetic, not fatal.

    The version attribute must be bumped whenever this file changes, or KXmlGui
    will keep serving a user's cached copy from ~/.local/share/kxmlgui5/.
-->
<gui name="ihaveissues" version="1"
     xmlns="http://www.kde.org/standards/kxmlgui/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.kde.org/standards/kxmlgui/1.0
                         http://www.kde.org/standards/kxmlgui/1.0/kxmlgui.xsd">

  <MenuBar>

    <Menu name="file">
      <text>&amp;File</text>
      <Action name="export_markdown" append="save_merge"/>
      <Action name="import_markdown" append="save_merge"/>
    </Menu>

    <Menu name="project">
      <text>&amp;Project</text>
      <Action name="add_issue"/>
      <Action name="edit_issue"/>
      <Action name="delete_issue"/>
      <Separator/>
      <Action name="github_sync"/>
      <Separator/>
      <Action name="options_configure"/>
    </Menu>

  </MenuBar>

  <ToolBar name="mainToolBar" noMerge="1">
    <text>Main Toolbar</text>
    <Action name="go_back_to_list"/>
    <Separator/>
    <Action name="file_open"/>
    <Action name="file_save"/>
    <Separator/>
    <Action name="add_issue"/>
    <Action name="edit_issue"/>
    <Action name="delete_issue"/>
    <Separator/>
    <Action name="github_sync"/>
  </ToolBar>

</gui>
