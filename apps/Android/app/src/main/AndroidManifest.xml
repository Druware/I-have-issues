<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GitHub sync lands in later work. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IHaveIssues">

        <!-- No orientation lock: the app must work on phone and tablet, portrait and landscape.
             singleTop so a second .issues file opened from a file manager reaches onNewIntent
             instead of starting a second copy of the app on top of the first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.IHaveIssues">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open .issues files from a file manager or a download.

                 `.issues` has no registered MIME type, so providers report whatever their extension
                 map says — usually application/octet-stream, sometimes application/json. Matching on
                 the MIME type alone would either miss the format or claim every octet-stream on the
                 device, so the filter matches the path instead and accepts any type. The repeated
                 patterns cover file names containing dots, which pathPattern's single wildcard
                 cannot express in one rule. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.issues" />
                <data android:pathPattern=".*\\..*\\.issues" />
                <data android:pathPattern=".*\\..*\\..*\\.issues" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.issues" />
            </intent-filter>
        </activity>
    </application>

</manifest>
