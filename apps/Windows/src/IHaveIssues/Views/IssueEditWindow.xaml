<Window x:Class="IHaveIssues.Views.IssueEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DisplayNumber}"
        Width="620"
        Height="760"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="MultiLine" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MinHeight" Value="84" />
        </Style>

        <!-- Every picker shows display names; raw values are never surfaced. -->
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource CommandBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancel" />
                <Button Content="Save" MinWidth="88" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>

                <TextBlock Text="Summary" Style="{StaticResource SectionHeaderText}" />

                <StackPanel Style="{StaticResource FormRow}">
                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Types}"
                                  SelectedItem="{Binding Type}"
                                  ItemTemplate="{StaticResource EnumItem}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Priorities}"
                                  SelectedItem="{Binding Priority}"
                                  ItemTemplate="{StaticResource EnumItem}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding Status}"
                                  ItemTemplate="{StaticResource EnumItem}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ResolutionKinds}"
                                  DisplayMemberPath="Text"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ResolutionKind}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Details" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reported" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding Reported}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reported by" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ReportedBy, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Area" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Milestone" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Milestone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Estimate" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Estimate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Labels &amp; People" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />

                <StackPanel Style="{StaticResource FormRow}">
                    <TextBlock Text="Labels" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Labels, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FormRow}">
                    <TextBlock Text="Assignees" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Assignees, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Separate multiple entries with commas."
                               Style="{StaticResource FormHelpText}" />
                </StackPanel>

                <TextBlock Text="Description" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />
                <TextBox Style="{StaticResource MultiLine}"
                         Margin="0,0,0,12"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Steps to Reproduce" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />
                <TextBox Style="{StaticResource MultiLine}"
                         Text="{Binding Steps, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="One step per line." Style="{StaticResource FormHelpText}" Margin="0,4,0,12" />

                <TextBlock Text="Environment" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />
                <TextBox Style="{StaticResource MultiLine}"
                         MinHeight="64"
                         Margin="0,0,0,12"
                         Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Notes / Investigation" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />
                <TextBox Style="{StaticResource MultiLine}"
                         Margin="0,0,0,12"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Resolution" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,6" />
                <TextBox Style="{StaticResource MultiLine}"
                         Margin="0,0,0,4"
                         Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
