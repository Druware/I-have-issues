<Window x:Class="IHaveIssues.Views.GitHubSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync to GitHub"
        Width="560"
        Height="580"
        MinWidth="440"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource CommandBar}">
            <DockPanel>
                <ProgressBar Width="120"
                             Height="4"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Done" MinWidth="88" IsCancel="True" Click="OnDone" />
                    <Button x:Name="SyncButton"
                            Content="Sync"
                            MinWidth="88"
                            Margin="8,0,0,0"
                            IsDefault="True"
                            Click="OnSync" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>

                <TextBlock Text="GitHub Repository" Style="{StaticResource SectionHeaderText}" />

                <Border Style="{StaticResource Card}"
                        Padding="14"
                        Visibility="{Binding HasIntegration, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Owner"
                                   Margin="0,0,16,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Owner}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Repository"
                                   Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Repository}" />
                    </Grid>
                </Border>

                <TextBlock Text="No GitHub repository configured."
                           Style="{StaticResource SecondaryText}"
                           Visibility="{Binding HasIntegration, Converter={StaticResource FalseToVisibility}}" />

                <TextBlock Text="Set the owner and repository in Project Settings."
                           Style="{StaticResource FormHelpText}" />

                <TextBlock Text="Authentication" Style="{StaticResource SectionHeaderText}" Margin="0,20,0,6" />

                <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasStoredToken, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="A token is saved for this repository."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="Remove"
                            Margin="12,0,0,0"
                            MinWidth="80"
                            Click="OnRemoveToken" />
                </StackPanel>

                <TextBlock Style="{StaticResource FormHelpText}"
                           Text="Requires the repo scope. Create one at github.com/settings/tokens. The token is stored in Windows Credential Manager, never in the document. Entering a token replaces the saved one; leave the field blank to keep it." />

                <!-- MARK: Outcome -->

                <Border Style="{StaticResource Card}"
                        Margin="0,20,0,0"
                        Padding="14"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </Border>

                <StackPanel Margin="0,20,0,0"
                            Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Last Sync" Style="{StaticResource SectionHeaderText}" />
                    <TextBlock Text="{Binding Summary}" />
                    <ItemsControl ItemsSource="{Binding Failures}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Style="{StaticResource CaptionText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
