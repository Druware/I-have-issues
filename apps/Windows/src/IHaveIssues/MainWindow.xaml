<Window x:Class="IHaveIssues.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IHaveIssues.Views"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        Closing="OnWindowClosing">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding AddIssueCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}" />
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="_Import Legacy Markdown…" Command="{Binding ImportMarkdownCommand}" />
                <MenuItem Header="_Export as Markdown…" Command="{Binding ExportMarkdownCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Issue">
                <MenuItem Header="_Add Issue" InputGestureText="Ctrl+Shift+N" Command="{Binding AddIssueCommand}" />
                <MenuItem Header="_Edit Issue…" Command="{Binding EditIssueCommand}" />
                <MenuItem Header="_Delete Issue" Command="{Binding DeleteIssueCommand}" />
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="Project _Settings…" Command="{Binding ProjectSettingsCommand}" />
                <MenuItem Header="Sync to _GitHub…" Command="{Binding GitHubSyncCommand}" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MARK: Sidebar -->

            <DockPanel Grid.Column="0">

                <Border DockPanel.Dock="Bottom" Style="{StaticResource CommandBar}">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE710;"
                                    ToolTip="Add Issue"
                                    Command="{Binding AddIssueCommand}" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE713;"
                                    ToolTip="Project Settings"
                                    Command="{Binding ProjectSettingsCommand}" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE895;"
                                    ToolTip="Sync to GitHub"
                                    Command="{Binding GitHubSyncCommand}" />
                        </StackPanel>

                        <Menu HorizontalAlignment="Right" Background="Transparent">
                            <!-- The icon font is scoped to the header so the submenu keeps the UI font. -->
                            <MenuItem ToolTip="Markdown">
                                <MenuItem.Header>
                                    <TextBlock Text="&#xE712;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </MenuItem.Header>
                                <MenuItem Header="Export as Markdown…"
                                          Command="{Binding ExportMarkdownCommand}" />
                                <MenuItem Header="Import Legacy Markdown…"
                                          Command="{Binding ImportMarkdownCommand}" />
                            </MenuItem>
                        </Menu>
                    </DockPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="IssueList"
                             ItemsSource="{Binding IssuesView}"
                             SelectedItem="{Binding SelectedIssue}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             MouseDoubleClick="OnIssueListDoubleClick">

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource SectionName}}"
                                                   FontWeight="SemiBold"
                                                   Margin="4,10,0,4"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <!-- One sidebar row: type dot, title over id, and a priority label. -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource TypeDot}"
                                               Margin="0,0,10,0"
                                               ToolTip="{Binding Type, Converter={StaticResource EnumDisplayName}}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource TitleOrPlaceholder}}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayNumber}"
                                                   Style="{StaticResource CaptionText}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource PriorityText}"
                                               Margin="8,0,4,0"
                                               Text="{Binding Priority, Converter={StaticResource EnumDisplayName}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No issues yet. Use Add Issue to create one."
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="24"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- MARK: Detail -->

            <Grid Grid.Column="2">
                <views:IssueDetailView DataContext="{Binding Detail}"
                                       Visibility="{Binding DataContext.Detail,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource NotNullToVisibility}}" />

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="32"
                            Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="No Issue Selected"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Select an issue from the sidebar, or add a new one."
                               Style="{StaticResource CaptionText}"
                               TextAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
