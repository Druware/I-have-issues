<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>IHaveIssues</RootNamespace>
    <AssemblyName>IHaveIssues</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode, which selects the built-in Fluent theme, is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IssuesKit\IssuesKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
