<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      InvariantGlobalization is deliberately NOT set: WPF resolves a specific culture for every
      binding, which throws under invariant mode. Formats that must not vary by machine — the JSON
      and markdown writers, and the estimate field — pin CultureInfo.InvariantCulture themselves.
    -->
    <Version>1.0.0</Version>
    <Company>Druware Software Designs</Company>
    <Product>I Have Issues</Product>
    <Authors>Druware Software Designs</Authors>
    <Copyright>Copyright (c) 2026 Druware Software Designs</Copyright>
    <!-- Dual-licensed; see COPYING at the repository root. NuGet accepts one SPDX expression, so
         this names the option that applies by default. -->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

</Project>
